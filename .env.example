# =====================================================================
# SatQuery AI / Project-Manhattan — Environment Variables
# =====================================================================

# ---------------------------------------------------------------------
# 1. CORE VLM & MULTIMODAL REASONING (REQUIRED FOR VERCEL)
# ---------------------------------------------------------------------
# Google Gemini API Key for multimodal satellite analysis, cloud detection,
# and bi-temporal change reasoning.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-flash-latest, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# 2. ALTERNATIVE VLM (OPTIONAL)
# ---------------------------------------------------------------------
# Zhipu AI / BigModel API key for GLM-4.6V-Flash analysis
# ZAI_API_KEY=your_zai_api_key_here

# ---------------------------------------------------------------------
# 3. DEDICATED AI SERVICE (OPTIONAL)
# ---------------------------------------------------------------------
# URL of the dedicated Python FastAPI service running Grounding DINO + SAM2.
# - For local development: http://127.0.0.1:8000
# - For production with external GPU (RunPod, Modal, GCP Cloud Run): https://your-service.example.com
# - On Vercel: If left unset, the platform automatically uses built-in cloud-native detection!
# AI_SERVICE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (REQUIRED FOR PRISMA BUILD)
# ---------------------------------------------------------------------
# SQLite connection string.
# On Vercel Serverless: file:/tmp/dev.db
# For Local Dev: file:./dev.db
DATABASE_URL=file:/tmp/dev.db

# ---------------------------------------------------------------------
# 5. SATELLITE IMAGERY PROVIDER
# ---------------------------------------------------------------------
# Satellite STAC provider for real-time and historical imagery
# Options: sentinel-stac (default) | nasa-gibs
SATELLITE_PROVIDER=sentinel-stac
